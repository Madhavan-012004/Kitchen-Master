{
  "name": "probloom-web",
  "version": "1.0.0",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && electron-builder"
  },
  "build": {
    "appId": "com.probloom.app",
    "productName": "ProBloom",
    "directories": {
      "output": "dist-electron"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": [
      {
        "from": "../backend2/target/backend2-1.0.0.jar",
        "to": "backend2.jar"
      }
    ]
  },
  "dependencies": {
    "@emailjs/browser": "^4.4.1",
    "@hello-pangea/dnd": "^18.0.1",
    "axios": "^1.7.2",
    "i18next": "^26.0.4",
    "jsbarcode": "^3.12.3",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-i18next": "^17.0.2",
    "react-is": "^19.2.5",
    "react-router-dom": "^6.23.1",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.7.5"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "vite": "^5.3.1",
    "vite-plugin-mkcert": "^2.0.0",
    "wait-on": "^9.0.10"
  }
}
