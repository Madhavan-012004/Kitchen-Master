{
  "name": "probloom-web",
  "version": "1.1.1",
  "type": "module",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "electron:dev": "concurrently \"vite\" \"wait-on http://localhost:3000 && electron .\"",
    "electron:build": "vite build && node build-nosign.cjs"
  },
  "build": {
    "appId": "com.probloom.ProBloom",
    "productName": "ProBloom",
    "directories": {
      "output": "dist-electron"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico",
      "forceCodeSigning": false,
      "signtoolOptions": null
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "installerIcon": "build/icon.ico",
      "uninstallerIcon": "build/icon.ico",
      "artifactName": "ProBloom_Setup_${version}.${ext}"
    },
    "files": [
      "dist/**/*",
      "electron/**/*",
      "package.json"
    ],
    "extraResources": []
  },
  "dependencies": {
    "@capacitor/android": "^8.4.1",
    "@capacitor/cli": "^8.4.1",
    "@capacitor/core": "^8.4.1",
    "@capacitor/filesystem": "^8.1.2",
    "@emailjs/browser": "^4.4.1",
    "@hello-pangea/dnd": "^18.0.1",
    "axios": "^1.7.2",
    "cordova-plugin-bluetooth-serial": "^0.4.7",
    "firebase": "^12.15.0",
    "form-data": "^4.0.5",
    "framer-motion": "^12.42.0",
    "i18next": "^26.0.4",
    "jsbarcode": "^3.12.3",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.21.0",
    "pdfjs-dist": "^5.7.284",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-hot-toast": "^2.6.0",
    "react-i18next": "^17.0.2",
    "react-is": "^19.2.5",
    "react-router-dom": "^6.23.1",
    "recharts": "^3.8.1",
    "socket.io-client": "^4.7.5",
    "tesseract.js": "^7.0.0"
  },
  "devDependencies": {
    "@types/react": "^18.3.3",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.1",
    "concurrently": "^9.2.1",
    "electron": "^42.0.1",
    "electron-builder": "^26.8.1",
    "electron-packager": "^17.1.2",
    "vite": "^5.3.1",
    "vite-plugin-mkcert": "^2.0.0",
    "wait-on": "^9.0.10"
  }
}
