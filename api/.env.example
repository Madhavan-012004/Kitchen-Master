# ===== PostgreSQL Database =====
DB_HOST=localhost
DB_PORT=5432
DB_NAME=kitchen_master_db
DB_USER=postgres
DB_PASSWORD=your_db_password_here

# ===== JWT =====
# IMPORTANT: Use the SAME secret as your Node.js backend JWT_SECRET
JWT_SECRET=your-super-secret-jwt-key-here

# ===== Google Gemini AI =====
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# ===== File Uploads =====
UPLOAD_PATH=./uploads
