{
  "expo": {
    "name": "ProBloom",
    "slug": "kitchen-master",
    "version": "1.0.0",
    "sdkVersion": "52.0.0",
    "orientation": "portrait",
    "icon": "./assets/LOGO.jpeg",
    "userInterfaceStyle": "dark",
    "scheme": "probloom",
    "splash": {
      "image": "./assets/LOGO.jpeg",
      "resizeMode": "contain",
      "backgroundColor": "#1A1A2E"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.probloom.app",
      "infoPlist": {
        "NSMicrophoneUsageDescription": "ProBloom needs microphone access for Voice-to-KOT ordering.",
        "NSCameraUsageDescription": "ProBloom needs camera access to scan and digitize menus.",
        "NSPhotoLibraryUsageDescription": "ProBloom needs photo access to upload menu images for AI digitization.",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#1A1A2E"
      },
      "package": "com.probloom.app",
      "permissions": [
        "RECORD_AUDIO",
        "CAMERA",
        "READ_EXTERNAL_STORAGE",
        "WRITE_EXTERNAL_STORAGE",
        "ACCESS_NETWORK_STATE",
        "VIBRATE",
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA",
        "android.permission.RECORD_AUDIO"
      ],
      "config": {
        "googleMaps": {
          "apiKey": "AIzaSyCYlrrl1EGaXHACVUsJ-nNvzGDFK6OS6M4"
        }
      }
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-camera",
        {
          "cameraPermission": "Allow ProBloom to use the camera."
        }
      ],
      "expo-font",
      "expo-location"
    ],
    "extra": {
      "API_URL": "https://kitchen-master.onrender.com",
      "eas": {
        "projectId": "9a30d950-23b0-4f0f-870d-bf37cc0ea95b"
      }
    }
  }
}
